# Yakitori platform configuration.
# Copy to .env and fill in. NEVER commit the real .env.
#
#   cp .env.example .env
#
# Only SECRET_KEY, the database values, and (in production) the Stripe/email/
# signing values normally need changing for local development. Everything else
# has a sensible default and is listed here for tuning.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Long random string. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# true for local development. Must be false in production.
DEBUG=true
# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
# Shown in emails and page titles.
PLATFORM_NAME=Yakitori

# Public URLs. Set the real origin at deploy time; never hard-code a domain.
APP_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=yakitori
DATABASE_USER=yakitori
DATABASE_PASSWORD=devpassword
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Seconds to reuse a DB connection (0 to close after each request).
DATABASE_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Sessions, cookies, and tokens
# ---------------------------------------------------------------------------
# Secure cookies require HTTPS; set both true in production.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Browser session lifetime in seconds (default 14 days).
SESSION_COOKIE_AGE=1209600
# How long an emailed sign-in link stays valid (seconds).
LOGIN_CHALLENGE_TTL_SECONDS=900
# How long the numeric sign-in code stays valid (seconds).
LOGIN_CODE_TTL_SECONDS=600
# Lifetime of a macOS API token, in days.
API_TOKEN_TTL_DAYS=365
# How long a device-authorization code stays valid (seconds).
DEVICE_CODE_TTL_SECONDS=900
# How often the app should poll for device approval (seconds).
DEVICE_CODE_POLL_INTERVAL=5
# Comma-separated origins allowed to post with CSRF (for example https://yakitori.example).
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Security (production values)
# ---------------------------------------------------------------------------
# Redirect all HTTP to HTTPS.
SECURE_SSL_REDIRECT=false
# HTTP Strict Transport Security max-age in seconds (0 disables).
SECURE_HSTS_SECONDS=0
# Content-Security-Policy header. Leave blank to use the built-in default.
CONTENT_SECURITY_POLICY=
# Comma-separated origins for CORS. Normally empty: the API is same-origin.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# console: prints the email to the server terminal (development only — no real
#          delivery). This is the default so the flow works with no accounts.
# smtp:    any SMTP host (Gmail app password, Postmark, SES SMTP, ...).
# resend:  Resend HTTP API (free tier; easiest real delivery, no email server).
#
# Verify any setup with:
#   python manage.py send_test_email you@example.com
#
# Resend quick start:
#   EMAIL_PROVIDER=resend
#   EMAIL_PROVIDER_API_KEY=re_your_key
#   EMAIL_FROM=Yakitori <onboarding@resend.dev>   # test mode: sends only to you
#   # After verifying a domain: EMAIL_FROM=Yakitori <noreply@yourdomain>
#
# Gmail SMTP quick start (create an App Password first):
#   EMAIL_PROVIDER=smtp
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_FROM=Yakitori <you@gmail.com>
EMAIL_PROVIDER=console
EMAIL_FROM=Yakitori <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds before an SMTP connection times out.
EMAIL_TIMEOUT=10
# API key for hosted providers (Resend).
EMAIL_PROVIDER_API_KEY=
# Django's mail backend, used only by the "console" provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---------------------------------------------------------------------------
# Commerce (Stripe Managed Payments)
# ---------------------------------------------------------------------------
# mock: performs no network calls; use for local development and tests.
# stripe: uses the real Stripe SDK (requires the keys below).
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Pin the Stripe API version; blank uses the SDK default.
STRIPE_API_VERSION=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=

# Customer-facing product/pricing. PRODUCT_PRICE_AMOUNT is in minor units
# (2900 = $29.00).
PRODUCT_NAME=Yakitori
PRODUCT_PRICE_AMOUNT=2900
PRODUCT_PRICE_CURRENCY=usd

# ---------------------------------------------------------------------------
# Licensing and the free trial
# ---------------------------------------------------------------------------
# Ed25519 key id and private key used to sign license authorizations.
# Generate a development pair with:  python manage.py generate_signing_key
LICENSE_SIGNING_KEY_ID=dev-1
LICENSE_SIGNING_PRIVATE_KEY=
# Alternative to the inline key: path to a PEM file (mode 600).
LICENSE_SIGNING_PRIVATE_KEY_FILE=
# Optional extra trusted verification keys, "kid=base64url,...".
LICENSE_VERIFICATION_PUBLIC_KEYS=
# How long the app keeps working offline on a cached (lifetime) authorization.
LICENSE_OFFLINE_GRACE_DAYS=30
# Length of the one-time free trial, in days.
TRIAL_DAYS=14
# TEST/TUNING ONLY: when non-zero, the trial lasts this many seconds instead of
# TRIAL_DAYS days. Useful for exercising trial expiry without waiting 14 days.
# Leave at 0 in any real deployment.
TRIAL_SECONDS=0

# ---------------------------------------------------------------------------
# Usernames, social, and leaderboards
# ---------------------------------------------------------------------------
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=30
# Days a user must wait between username changes.
USERNAME_CHANGE_COOLDOWN_DAYS=30
# Extra reserved usernames (comma-separated) beyond the built-in list.
USERNAME_RESERVED_EXTRA=
# Page size for followers/following and leaderboard responses.
FOLLOW_PAGE_SIZE=50
LEADERBOARD_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Rate limits: (requests, window seconds)
# ---------------------------------------------------------------------------
# Generous per-IP login caps because many users can share one address.
RL_LOGIN_REQUEST=20
RL_LOGIN_VERIFY=30
# Device-authorization polling is frequent, so it is capped per device code.
RL_DEVICE_POLL=600
RL_USERNAME_CHANGE=5
RL_USERNAME_SEARCH=120
RL_FOLLOW=300
RL_PROFILE_MUTATION=60
RL_LEADERBOARD=300
RL_PURCHASE_CLAIM=10
RL_LICENSE_VALIDATE=600
RL_INSTALLATION_REGISTER=60
RL_ADMIN=600
RL_CHECKOUT=30
RL_STATISTICS_SUBMIT=120

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
